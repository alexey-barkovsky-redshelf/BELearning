generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt String
  updatedAt String
}

model Product {
  id             String              @id @default(uuid())
  name           String
  slug           String              @unique
  description    String?
  price          Float
  currency       String              @default("USD")
  manufacturer   String?
  createdAt      String
  updatedAt      String
  categoryRows   ProductCategory[]
  promotionRows  PromotionProduct[]

  @@index([name])
  @@index([price])
  @@index([createdAt])
}

model Category {
  code         String            @id
  name         String
  parentCode   String?
  parent       Category?         @relation("CategoryHierarchy", fields: [parentCode], references: [code], onDelete: SetNull)
  children     Category[]        @relation("CategoryHierarchy")
  createdAt    String
  updatedAt    String
  productRows  ProductCategory[]

  @@index([parentCode])
}

model ProductCategory {
  productId String
  code      String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([productId, code])
  @@index([code])
}

model Promotion {
  id            String             @id @default(uuid())
  name          String
  description   String?
  discountPct   Float
  validFrom     String
  validTo       String
  isActive      Boolean            @default(true)
  createdAt     String
  updatedAt     String
  productRows   PromotionProduct[]

  @@index([validFrom, validTo])
  @@index([isActive])
}

model PromotionProduct {
  promotionId         String
  productId           String
  discountPctOverride Float?
  promotion           Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  status    String      @default("draft")
  currency  String      @default("USD")
  createdAt String
  updatedAt String
  items     OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  productTitle     String
  priceAtPurchase  Float
  quantity         Int

  @@index([orderId])
  @@index([productId])
}
