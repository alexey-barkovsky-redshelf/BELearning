{
  "name": "belearning",
  "private": true,
  "version": "0.0.1",
  "description": "BELearning ecommerce monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "scripts": {
    "build": "yarn workspaces run build",
    "clean": "yarn workspaces run clean",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build:shared": "yarn workspace @belearning/shared build",
    "build:utils": "yarn workspace @belearning/utils build",
    "test:api": "yarn build:shared && yarn workspace @belearning/api test",
    "dev:api": "yarn workspace @belearning/shared build && yarn workspace @belearning/utils build && yarn workspace @belearning/api dev",
    "dev:web": "yarn workspace @belearning/shared build && yarn workspace @belearning/utils build && yarn workspace @belearning/web dev",
    "db:status": "yarn workspace @belearning/api run db:status",
    "db:generate": "yarn workspace @belearning/api run db:generate",
    "db:migrate": "yarn workspace @belearning/api run db:migrate:deploy",
    "db:migrate:dev": "yarn workspace @belearning/api run db:migrate",
    "db:push": "yarn workspace @belearning/api run db:push",
    "db:studio": "yarn workspace @belearning/api run db:studio",
    "db:seed": "yarn workspace @belearning/api run db:seed"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-config-prettier": "^9.1.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  }
}
